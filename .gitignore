# Environment and Secrets (Never commit secrets)
.env
.env.local
.env.*.local
frontend/.env

# Virtual Environments
.venv/
venv/
env/
ENV/

# Python Byte-code & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.log

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
dist/

# Large Datasets & Processed Partition Storage
data/raw/*.csv
data/processed/train_features/
data/processed/*.parquet

# Keep models trackable for demonstration
!backend/models/*.json

# Scratch & Temporary experiments
scratch/

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
