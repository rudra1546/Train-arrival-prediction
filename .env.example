# =============================================================================
# SIH Problem Statement 26028 - Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure the variables accordingly.
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL.
# =============================================================================

# RailRadar Live Train Status API Key
# Sign up and obtain key from: https://railradar.in
# Leave blank for local development / mock mode.
RAILRADAR_API_KEY=your_railradar_api_key_here

# Base URL for RailRadar API
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Request Timeout in seconds
RAILRADAR_TIMEOUT_SECONDS=10

# CORS Allowed Origins (comma-separated list for frontend clients)
CORS_ORIGINS=http://localhost:5173

# Response Cache TTL in seconds (in-memory response caching)
RAILRADAR_CACHE_TTL_SECONDS=30

# Application Environment (development, testing, production)
APP_ENV=development
